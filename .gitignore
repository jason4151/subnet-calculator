# Node.js / npm
node_modules/
npm-debug.log
yarn-error.log
package-lock.json  # Optional: include if you use npm and don't want lockfile conflicts

# Vite build output
dist/
dist-ssr/

# Logs and temporary files
*.log
*.log.*
.DS_Store  # macOS-specific
Thumbs.db  # Windows-specific

# Editor and IDE files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Local environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Docker
Dockerfile.*  # Exclude any variant Dockerfiles (e.g., Dockerfile.dev), but keep Dockerfile
*.dockerignore

# Helm
helm/Chart.lock  # Helm dependency lock file, if you use dependencies (not needed here yet)

# GitHub Actions (optional, typically not needed unless you have local secrets)
.github/*.local

# Miscellaneous
*.swp
*.swo
*~
